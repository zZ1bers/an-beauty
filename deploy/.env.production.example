# Copy to /opt/an.beauty/.env on the VPS (never commit real values)

DOMAIN=an-beauty.com

POSTGRES_USER=anbeauty
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=anbeauty

JWT_SECRET=change-me-long-random-jwt-secret

# Same origin via Caddy → nginx → /api
CORS_ORIGIN=https://an-beauty.com
PUBLIC_URL=https://an-beauty.com/api

# Only for ONE-TIME seed on the server (not used by compose automatically)
ADMIN_EMAIL=admin@an.beauty
ADMIN_PASSWORD=change-me-strong-admin-password

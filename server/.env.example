# Local
DATABASE_URL="postgresql://anbeauty:anbeauty@localhost:5432/anbeauty?schema=public"
JWT_SECRET="change-me-in-production-anbeauty-secret"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
PUBLIC_URL="http://localhost:3001"
NODE_ENV=development

# Admin created by `npm run db:seed` (seed WIPEs the whole database)
ADMIN_EMAIL=admin@an.beauty
ADMIN_PASSWORD=

# Production — same keys, your values:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/anbeauty?schema=public"
# JWT_SECRET="long-random-secret"
# PORT=3001
# CORS_ORIGIN="https://your-frontend.example.com"
# PUBLIC_URL="https://api.your-domain.com"
# NODE_ENV=production
# ADMIN_EMAIL=admin@an.beauty
# ADMIN_PASSWORD="strong-unique-password"

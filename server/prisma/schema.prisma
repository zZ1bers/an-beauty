generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MASTER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Locale {
  ru
  de
}

enum NotificationType {
  BOOKING
  PROMO
  SYSTEM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  firstName    String
  lastName     String
  phone        String?
  locale       Locale    @default(ru)
  isActive     Boolean   @default(true)
  /// Hashed 6-digit password reset code
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetAttempts      Int       @default(0)
  resetSentAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientProfile ClientProfile?
  masterProfile MasterProfile?
  notifications Notification[]
  notesAuthored ClientNote[]   @relation("NoteAuthor")
}

model ClientProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  birthDate    DateTime?
  crmNotes     String?
  allergies    String?
  preferences  String?
  totalVisits  Int       @default(0)
  totalSpent   Decimal   @default(0) @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  notes    ClientNote[]
}

model MasterProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  roleRu     String   @default("")
  roleDe     String   @default("")
  bioRu      String   @default("")
  bioDe      String   @default("")
  imageUrl   String   @default("")
  rating     Decimal  @default(5) @db.Decimal(3, 2)
  isActive   Boolean  @default(true)
  /// Show on landing MastersStrip (booking still lists all active)
  showOnHome Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     MasterService[]
  bookings     Booking[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  /// Explicit open windows (used from DEFAULT_CLOSED_FROM — time closed until opened)
  opens        MasterOpen[]
  clientNotes  ClientNote[]
}

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String
  nameRu    String
  nameDe    String
  /// Cover image for booking category cards
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String   @unique
  nameRu      String
  nameDe      String
  descriptionRu String
  descriptionDe String
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int
  imageUrl    String
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  masters      MasterService[]
  bookings     Booking[]
  promoLinks   PromoService[]
}

model MasterService {
  masterId  String
  serviceId String

  master  MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
}

model Booking {
  id            String        @id @default(cuid())
  /// Null for walk-in bookings created by admin (no client account)
  clientId      String?
  masterId      String
  serviceId     String
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(PENDING)
  priceSnapshot Decimal       @db.Decimal(10, 2)
  notes         String?
  /// Walk-in guest name when clientId is null
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?
  cancelledAt   DateTime?
  /// When day-before SMS reminder was sent
  reminderSmsSentAt DateTime?
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client  ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  master  MasterProfile  @relation(fields: [masterId], references: [id])
  service Service        @relation(fields: [serviceId], references: [id])

  @@index([masterId, startsAt])
  @@index([clientId, startsAt])
  @@index([status])
  @@index([startsAt])
  @@index([reminderSmsSentAt, startsAt])
}

model WorkingHours {
  id        String @id @default(cuid())
  masterId  String
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  startTime String
  endTime   String

  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, dayOfWeek])
  @@index([masterId])
}

model TimeOff {
  id       String   @id @default(cuid())
  masterId String
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, startsAt])
}

/// Master explicitly opened window (required for bookings from DEFAULT_CLOSED_FROM).
model MasterOpen {
  id       String   @id @default(cuid())
  masterId String
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, startsAt])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  masterId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User           @relation("NoteAuthor", fields: [authorId], references: [id])
  master MasterProfile? @relation(fields: [masterId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

model Promo {
  id          String    @id @default(cuid())
  headlineRu  String
  headlineDe  String
  bodyRu      String
  bodyDe      String
  discountPct Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services PromoService[]
}

model PromoService {
  promoId   String
  serviceId String

  promo   Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([promoId, serviceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
